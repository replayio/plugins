{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "replay": {
      "type": "streamable-http",
      "url": "https://dispatch.replay.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": ["openid", "profile", "email"]
          }
        }
      }
    }
  }
}
