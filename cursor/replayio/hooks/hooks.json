{
  "hooks": {
    "afterShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/live/rrweb.mjs\" hook",
        "matcher": "agent-browser|browser-open|browser-close"
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/live/rrweb.mjs\" stop >/dev/null"
      }
    ]
  }
}
